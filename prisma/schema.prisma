// Prisma schema for Delta Kebab - Multi-branch restaurant ordering and delivery system

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Force output into the project's node_modules so hosted `npx prisma generate`
  // produces a client inside the deployment folder instead of a global path.
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & ROLES
// ============================================================================

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?
  passwordHash      String?
  authProvider      String   @default("NATIVE") // NATIVE, GOOGLE, GITHUB
  providerId        String?
  isBlocked         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  roles             UserRole[]
  restaurantStaff   RestaurantStaff[]
  addresses         CustomerAddress[]
  orders            Order[]
  driverProfile     DriverProfile?
  sentMessages      Message[]
  statusHistories   OrderStatusHistory[]
  orderEvents       OrderEvent[]
  notifications     Notification[]

  @@index([email])
  @@index([phone])
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique // SUPER_ADMIN, RESTAURANT_ADMIN, KITCHEN, DRIVER, REPORTER, CUSTOMER
  createdAt DateTime @default(now())

  // Relations
  users     UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================================
// RESTAURANTS & BRANCHES
// ============================================================================

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branches              Branch[]
  info                  RestaurantInfo?
  hours                 RestaurantHours[]
  deliveryRules         RestaurantDeliveryRules?
  itemOverrides         RestaurantItemOverride[]

  @@index([active])
}

model Branch {
  id              String   @id @default(cuid())
  restaurantId    String
  name            String
  street          String
  buildingNumber  String
  city            String
  postalCode      String
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  phone           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff           RestaurantStaff[]
  itemPrices      ItemPrice[]
  orders          Order[]

  @@index([restaurantId])
  @@index([active])
}

model RestaurantStaff {
  id          String   @id @default(cuid())
  userId      String
  branchId    String
  assignedAt  DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model RestaurantInfo {
  id              String   @id @default(cuid())
  restaurantId    String   @unique
  packagingFee    Decimal  @default(0.00) @db.Decimal(10, 2)
  plasticBagFee   Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt

  // Relations
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model RestaurantHours {
  id            String   @id @default(cuid())
  restaurantId  String
  dayRange      Int      // 0-6 for Monday-Sunday
  openTime      String   // HH:mm format
  closeTime     String   // HH:mm format

  // Relations
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayRange])
  @@index([restaurantId])
}

model RestaurantDeliveryRules {
  id                  String   @id @default(cuid())
  restaurantId        String   @unique
  minOrderValue       Decimal  @default(0.00) @db.Decimal(10, 2)
  minDeliveryDistance Decimal  @default(0.00) @db.Decimal(10, 2)
  maxDeliveryDistance Decimal  @default(100.00) @db.Decimal(10, 2)
  baseFee             Decimal  @default(0.00) @db.Decimal(10, 2)
  perKmFee            Decimal  @default(0.00) @db.Decimal(10, 2)

  // Relations
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ============================================================================
// MENU SYSTEM
// ============================================================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items     Item[]

  @@index([active])
}

model Item {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  prices      ItemPrice[]
  overrides   RestaurantItemOverride[]

  @@index([categoryId])
  @@index([active])
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

model ItemPrice {
  id        String   @id @default(cuid())
  itemId    String
  branchId  String
  price     Decimal  @db.Decimal(10, 2)
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime @default(now())

  // Relations
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([branchId])
  @@index([validFrom])
  @@index([validTo])
}

model RestaurantItemOverride {
  id          String   @id @default(cuid())
  restaurantId String
  itemId      String
  available   Boolean  @default(true)
  specialPrice Decimal?  @db.Decimal(10, 2)
  notes       String?

  // Relations
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, itemId])
  @@index([restaurantId])
  @@index([itemId])
}

// ============================================================================
// CUSTOMERS & ADDRESSES
// ============================================================================

model CustomerAddress {
  id              String   @id @default(cuid())
  userId          String
  label           String?
  street          String
  buildingNumber  String
  apartmentNumber String?
  floor           String?
  city            String
  postalCode      String
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  accessNotes     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city])
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id                  String   @id @default(cuid())
  customerId          String
  branchId            String
  orderType           String   // PICKUP, DELIVERY
  status              String   @default("NEW") // NEW, ACCEPTED, PREPARING, READY_FOR_PICKUP, PICKED_UP, IN_DELIVERY, DELIVERED, FAILED_DELIVERY, CANCELLED
  totalPrice          Decimal  @db.Decimal(10, 2)
  deliveryFee         Decimal? @db.Decimal(10, 2)
  
  // Snapshot fields - captured at order time
  customerName        String
  customerPhone       String
  street              String?
  buildingNumber      String?
  apartmentNumber     String?
  floor               String?
  city                String?
  postalCode          String?
  latitude            Decimal? @db.Decimal(10, 8)
  longitude           Decimal? @db.Decimal(11, 8)
  accessNotes         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  customer            User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  events              OrderEvent[]
  driverAssignment    DriverAssignment?
  chat                Chat?
  payment             Payment?

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  itemName  String
  sizeName  String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())

  // Relations
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id              String   @id @default(cuid())
  orderId         String
  status          String
  changedByUserId String?
  changedByRole   String?
  reason          String?
  createdAt       DateTime @default(now())

  // Relations
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventType String
  userId    String
  role      String
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================================================
// DRIVER SYSTEM
// ============================================================================

model DriverProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  active      Boolean  @default(true)
  vehicleInfo Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments DriverAssignment[]

  @@index([active])
}

model DriverAssignment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  driverId        String
  assignedAt      DateTime @default(now())
  pickedUpAt      DateTime?
  deliveryStartedAt DateTime?
  completedAt     DateTime?

  // Relations
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver          DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([orderId])
}

// ============================================================================
// CHAT SYSTEM
// ============================================================================

model Chat {
  id        String   @id @default(cuid())
  orderId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([orderId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  // Relations
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  method                String   // CASH, CARD, STRIPE, REVOLUT, BLIK
  status                String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  amount                Decimal  @db.Decimal(10, 2)
  provider              String?
  providerTransactionId String?
  failedRetries         Int      @default(0)
  nextRetryAt           DateTime?
  webhookData           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
