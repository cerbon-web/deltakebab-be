{
  "name": "delta-be",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "postinstall": "npx prisma@5.22.0 generate --schema=./prisma/schema.prisma",
    "prestart": "npm run db:prepare",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "migrate": "npx prisma migrate dev",
    "migrate:reset": "npx prisma migrate reset --force",
    "db:prepare": "node scripts/run-prisma.js generate --schema=./prisma/schema.prisma && node scripts/run-prisma.js db push --skip-generate",
    "db:seed": "node scripts/run-prisma.js db seed",
    "verify:db-utils": "node scripts/verify-db-utils.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.0",
    "winston": "^3.10.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "mysql2": "^3.23.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
